# Copy to .env.local; never use VITE_ for secrets. Restart pnpm dev after editing.
# Local Ollama: install/pull a suitable model separately, then use its exact tag.
NARRATIVE_PROVIDER=ollama
NARRATIVE_BASE_URL=http://127.0.0.1:11434
NARRATIVE_MODEL=
# Optional explicit reasoning mode for supported Ollama models. Empty keeps model default.
NARRATIVE_THINKING=
# Optional separate model for per-song cinematic creation. Empty reuses NARRATIVE_MODEL.
# Local comparison on this project: qwen3.5:9b, while semantic segmentation stays on 4B.
CREATIVE_MODEL=
CREATIVE_CONTEXT_TOKENS=24576
CREATIVE_THINKING=false
CREATIVE_INTENT_THINKING=false
# Optional compatible Chat Completions service: provider=compatible, base ends in /v1.
# Sends lyrics and acoustic summaries to that configured service; never sends the MP3.
NARRATIVE_API_KEY=
